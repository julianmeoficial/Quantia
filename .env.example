# Copia este archivo como .env.local y ajusta los valores.
# Solo valores NO secretos: todo NEXT_PUBLIC_* termina en el bundle del navegador.

# Origen de la API de Quantia (el cliente agrega /api/v1).
# Local: http://localhost:4000
# Staging (Railway, solo HTTP/WS): https://quantiaapi-production.up.railway.app
NEXT_PUBLIC_API_URL=http://localhost:4000
# Origen del gateway Socket.io (namespaces /projects y /notifications).
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
