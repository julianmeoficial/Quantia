# Copia este archivo como .env.local y ajusta los valores.
# Solo valores NO secretos: todo NEXT_PUBLIC_* termina en el bundle del navegador.

# Origen de la API de Quantia (el cliente agrega /api/v1).
# NO uses http://localhost:3000 — ese es el frontend Next, no la API.
# Staging (Railway): https://quantiaapi-production.up.railway.app
# API Nest local:     http://localhost:4000
NEXT_PUBLIC_API_URL=https://quantiaapi-production.up.railway.app
# Origen del gateway Socket.io (namespaces /projects y /notifications).
NEXT_PUBLIC_SOCKET_URL=https://quantiaapi-production.up.railway.app
