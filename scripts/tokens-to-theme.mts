/**
 * Converts Figma W3C token JSON → src/theme/{light,dark,scales}.ts
 *
 * Sources (canonical):
 *   src/theme/figma/semantic.{light,dark}.tokens.json
 *   src/theme/figma/primitives.tokens.json
 *
 * Run: npm run tokens:build
 */

import { mkdirSync, readFileSync, writeFileSync } from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";

const ROOT = join(dirname(fileURLToPath(import.meta.url)), "..");
const FIGMA_DIR = join(ROOT, "src/theme/figma");
const OUT_DIR = join(ROOT, "src/theme");

const BANNER = `// AUTO-GENERATED by scripts/tokens-to-theme.mts — do not edit.
// Source: src/theme/figma/*.tokens.json · Re-run: npm run tokens:build
`;

type Json = null | boolean | number | string | Json[] | { [key: string]: Json };

type TokenLeaf = {
  $type?: string;
  $value?:
    | number
    | string
    | {
        colorSpace?: string;
        components?: number[];
        alpha?: number;
        hex?: string;
      };
};

function isTokenLeaf(node: unknown): node is TokenLeaf {
  return typeof node === "object" && node !== null && ("$value" in node || "$type" in node);
}

function resolveColor(value: TokenLeaf["$value"]): string {
  if (typeof value === "string") return value;
  if (typeof value !== "object" || value === null || !("hex" in value) || !value.hex) {
    throw new Error(`Expected color $value with hex, got ${JSON.stringify(value)}`);
  }
  const hex = value.hex.toUpperCase();
  const alpha = value.alpha ?? 1;
  if (alpha >= 1) return hex;
  const r = Number.parseInt(hex.slice(1, 3), 16);
  const g = Number.parseInt(hex.slice(3, 5), 16);
  const b = Number.parseInt(hex.slice(5, 7), 16);
  const a = Math.round(alpha * 100) / 100;
  return `rgba(${r},${g},${b},${a})`;
}

function resolveNumber(value: TokenLeaf["$value"]): number {
  if (typeof value === "number") return value;
  throw new Error(`Expected number $value, got ${JSON.stringify(value)}`);
}

function pxToRem(px: number): string {
  return `${px / 16}rem`;
}

function walkTokens(
  node: Json,
  path: string[],
  onLeaf: (path: string[], leaf: TokenLeaf) => void,
): void {
  if (!node || typeof node !== "object" || Array.isArray(node)) return;
  if (isTokenLeaf(node)) {
    onLeaf(path, node);
    return;
  }
  for (const [key, child] of Object.entries(node)) {
    if (key.startsWith("$")) continue;
    walkTokens(child, [...path, key], onLeaf);
  }
}

function loadJson(fileName: string): Json {
  return JSON.parse(readFileSync(join(FIGMA_DIR, fileName), "utf8")) as Json;
}

function collectColors(fileName: string): Map<string, string> {
  const data = loadJson(fileName);
  const map = new Map<string, string>();
  walkTokens(data, [], (path, leaf) => {
    if (leaf.$type !== "color") return;
    map.set(path.join("/"), resolveColor(leaf.$value));
  });
  return map;
}

function collectNumbers(fileName: string): Map<string, number> {
  const data = loadJson(fileName);
  const map = new Map<string, number>();
  walkTokens(data, [], (path, leaf) => {
    if (leaf.$type !== "number") return;
    map.set(path.join("/"), resolveNumber(leaf.$value));
  });
  return map;
}

function requireColor(map: Map<string, string>, path: string): string {
  const value = map.get(path);
  if (!value) throw new Error(`Missing color token: ${path}`);
  return value;
}

function requireNumber(map: Map<string, number>, path: string): number {
  const value = map.get(path);
  if (value === undefined) throw new Error(`Missing number token: ${path}`);
  return value;
}

type StatusTone = "success" | "warning" | "error" | "info" | "neutral";

function buildColors(map: Map<string, string>) {
  const status = (tone: StatusTone) => ({
    text: requireColor(map, `status/${tone}/text`),
    icon: requireColor(map, `status/${tone}/icon`),
    bg: requireColor(map, `status/${tone}/bg`),
  });

  return {
    bg: {
      canvas: requireColor(map, "bg/canvas"),
      surface: requireColor(map, "bg/surface"),
      subtle: requireColor(map, "bg/subtle"),
    },
    text: {
      primary: requireColor(map, "text/primary"),
      secondary: requireColor(map, "text/secondary"),
    },
    border: {
      subtle: requireColor(map, "border/subtle"),
      control: requireColor(map, "border/control"),
    },
    /** Alias of Figma `action/*` (DS-93 theme API uses `brand`). */
    brand: {
      primary: requireColor(map, "action/primary"),
      hover: requireColor(map, "action/primary-hover"),
      pressed: requireColor(map, "action/primary-pressed"),
      onPrimary: requireColor(map, "action/on-primary"),
    },
    selection: {
      bg: requireColor(map, "selection/bg"),
      text: requireColor(map, "selection/text"),
    },
    focus: {
      ring: requireColor(map, "focus/ring"),
    },
    status: {
      success: status("success"),
      warning: status("warning"),
      error: status("error"),
      info: status("info"),
      neutral: status("neutral"),
    },
  };
}

function serialize(value: unknown, indent = 0): string {
  const pad = "  ".repeat(indent);
  const padIn = "  ".repeat(indent + 1);
  if (typeof value === "string") return JSON.stringify(value);
  if (typeof value === "number" || typeof value === "boolean") return String(value);
  if (Array.isArray(value)) {
    if (value.length === 0) return "[]";
    const items = value.map((item) => `${padIn}${serialize(item, indent + 1)},`).join("\n");
    return `[\n${items}\n${pad}]`;
  }
  if (value && typeof value === "object") {
    const entries = Object.entries(value as Record<string, unknown>);
    if (entries.length === 0) return "{}";
    const body = entries
      .map(([key, val]) => {
        const safeKey =
          /^[A-Za-z_$][\w$]*$/.test(key) || /^\d+$/.test(key) ? key : JSON.stringify(key);
        return `${padIn}${safeKey}: ${serialize(val, indent + 1)},`;
      })
      .join("\n");
    return `{\n${body}\n${pad}}`;
  }
  return "null";
}

function writeColorsFile(mode: "light" | "dark", colors: ReturnType<typeof buildColors>) {
  const exportName = mode === "light" ? "lightColors" : "darkColors";
  const content = `${BANNER}
export const ${exportName} = ${serialize(colors)} as const;

export type ${mode === "light" ? "Light" : "Dark"}Colors = typeof ${exportName};
`;
  writeFileSync(join(OUT_DIR, `${mode}.ts`), content, "utf8");
}

function writeScalesFile(numbers: Map<string, number>) {
  const spaceKeys = [4, 8, 12, 16, 24, 32, 48, 64] as const;
  const space = Object.fromEntries(
    spaceKeys.map((key) => [key, pxToRem(requireNumber(numbers, `spacing/${key}`))]),
  );

  const radii = {
    control: pxToRem(requireNumber(numbers, "radius/control")),
    card: pxToRem(requireNumber(numbers, "radius/card")),
    featured: pxToRem(requireNumber(numbers, "radius/featured")),
    full: "9999rem",
  };

  const layout = {
    sidebar: pxToRem(requireNumber(numbers, "layout/sidebar")),
    header: pxToRem(requireNumber(numbers, "layout/header")),
  };

  const sizes = {
    control: pxToRem(requireNumber(numbers, "size/control")),
    tableRowMin: pxToRem(requireNumber(numbers, "size/table-row-min")),
    touchTarget: pxToRem(requireNumber(numbers, "size/control")),
    containerMax: "90rem",
  };

  const durationMin = requireNumber(numbers, "motion/duration-min");
  const durationMax = requireNumber(numbers, "motion/duration-max");
  const durationBase = 200;

  const motion = {
    duration: {
      fast: `${durationMin}ms`,
      base: `${durationBase}ms`,
      slow: `${durationMax}ms`,
    },
    durationSeconds: {
      fast: durationMin / 1000,
      base: durationBase / 1000,
      slow: durationMax / 1000,
    },
    easing: {
      standard: "cubic-bezier(0.2, 0, 0, 1)",
      emphasized: "cubic-bezier(0.3, 0, 0, 1)",
    },
  };

  const content = `${BANNER}
export const space = ${serialize(space)} as const;

export const radii = ${serialize(radii)} as const;

export const layout = ${serialize(layout)} as const;

export const sizes = ${serialize(sizes)} as const;

export const motion = ${serialize(motion)} as const;

export type ThemeSpace = typeof space;
export type ThemeRadii = typeof radii;
export type ThemeLayout = typeof layout;
export type ThemeSizes = typeof sizes;
export type ThemeMotion = typeof motion;
`;
  writeFileSync(join(OUT_DIR, "scales.ts"), content, "utf8");
}

function main() {
  mkdirSync(OUT_DIR, { recursive: true });

  const lightMap = collectColors("semantic.light.tokens.json");
  const darkMap = collectColors("semantic.dark.tokens.json");
  const numbers = collectNumbers("primitives.tokens.json");

  writeColorsFile("light", buildColors(lightMap));
  writeColorsFile("dark", buildColors(darkMap));
  writeScalesFile(numbers);

  process.stdout.write("Wrote src/theme/light.ts, dark.ts, scales.ts\n");
}

main();
